# Backend configuration (read by python-decouple from this file or the env).
# Copy to `.env` and fill in real values. `.env` must never be committed.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

# Telegram bot — calendar event reminders.
# Create the bot with @BotFather; the token is a secret.
TELEGRAM_BOT_TOKEN=
# The bot's @username (without the @), used to build the t.me connect link.
TELEGRAM_BOT_USERNAME=
# false: receive updates by long-polling (run `manage.py run_telegram_bot`) — good for dev.
# true:  receive updates by webhook (needs a public HTTPS URL) — for production.
TELEGRAM_USE_WEBHOOK=False
# Random secret embedded in the webhook URL path; only needed when using a webhook.
TELEGRAM_WEBHOOK_SECRET=

# Cache backend. Holds the Telegram bot's short-lived conversation state (the
# multi-step "create task/subtask" flows). The default in-process cache is fine
# for development (single long-polling process) and tests. In production behind
# a webhook served by multiple workers, point this at Redis so the state is
# shared across them:
#   CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
#   CACHE_LOCATION=redis://localhost:6379/1
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=ticktask-local

# Google Calendar sync — optional, per-user (connected from Settings in the
# app). Leave blank to leave the feature off. See DEPLOY.md for how to create
# the OAuth client in the Google Cloud Console.
FRONTEND_URL=http://localhost:3000
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the OAuth client.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/google-calendar/oauth/callback/
